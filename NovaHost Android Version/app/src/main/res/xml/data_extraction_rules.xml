<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-transfer rules, API 31 and above. Same reasoning as
    backup_rules.xml: the Keystore master key cannot travel, so neither should
    the ciphertext it is the only way to read.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_terminal_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_terminal_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
