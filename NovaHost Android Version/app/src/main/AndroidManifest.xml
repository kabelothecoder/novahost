<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
        android:allowBackup is off, deliberately.

        Auto Backup was restoring metahost_prefs on reinstall, which carries the
        licence key and the robot's identity (name, avatar, accent). A reinstall
        therefore came up wearing the previous robot's art, and a restore onto a
        different handset produced a licence key bound to the old device that
        could never validate.

        Nothing here is worth restoring: the licence is device-bound by design,
        and appearance is re-derived from the licence on activation. A fresh
        install should be genuinely fresh.
    -->
    <application
        android:name=".NovaHostApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="NovaHost"
        android:supportsRtl="true"
        android:theme="@style/Theme.NovaHost">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.App.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link: Payfast payment/success and payment/cancel return URLs -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="metahost"
                    android:host="payment" />
            </intent-filter>
        </activity>

        <!-- Nano Banana: MT4/MT5 connection watcher foreground service -->
        <service
            android:name=".service.NanoBananaService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- NovaHost Pulse Service: Floating Bubble & HUD -->
        <service
            android:name=".service.NovaHostPulseService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />


    </application>
</manifest>
